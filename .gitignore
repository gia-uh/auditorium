### VisualStudioCode Patch ###
# Ignore all local history of files
.history

# End of https://www.gitignore.io/api/visualstudiocode,linux,python

# Custom rules (everything added below won't be overriden by 'Generate .gitignore File' if you use 'Update' option)
*.html
!docs/**/*.html
demo_deck.html
demo_deck.pdf
*.webm

# The client shells are shipped source, not build output. The blanket *.html
# rule above would drop them from the wheel -- and a missing preview.html is a
# 500 on /preview that nothing in the test suite would notice.
!auditorium/static/*.html
# The templates' pages are shipped source too: without this, template show and
# new crash on a clean checkout and the wheel has no templates
# (tests/test_templates.py::test_every_template_file_ships).
!auditorium/templates/**/*.html

# In 5.0 an index.html is the source a project is written in, so the examples
# and the test fixture projects are tracked. What a project builds lands in
# its dist/, which is output.
!examples/**/*.html
!tests/fixtures/**/*.html
dist/
!tests/fixtures/*.html
